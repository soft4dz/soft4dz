APP_NAME=Soft4dz
APP_ENV=development
APP_URL=http://localhost/soft4dz
# Obligatoire en production : 32+ caractères aléatoires (ex. : php -r "echo bin2hex(random_bytes(32));")
APP_SECRET=

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=soft4dz
DB_USERNAME=root
DB_PASSWORD=

MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@soft4dz.com
MAIL_FROM_NAME=Soft4dz
MAIL_ENCRYPTION=tls

# WhatsApp Cloud API (Meta Business) — laisser vide pour désactiver l'envoi auto
# https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

AI_API_KEY=
AI_ENDPOINT=https://api.anthropic.com/v1

# Connexion sociale — laisser vide pour désactiver le bouton correspondant
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Chargily Pay (paiement) — test | live
CHARGILY_MODE=test
CHARGILY_SECRET_KEY=

UPLOAD_MAX_SIZE=10485760
UPLOAD_PATH=uploads/

SESSION_LIFETIME=7200

# Installateur web (setup.php) — laisser vide en production. Préférer : php database/install.php
SETUP_TOKEN=
