# Copier ce fichier en .env.local et remplir les valeurs.

# Chargily Pay (CIB / Edahabia) — https://pay.chargily.com
# Sans clé : mode démo, aucune transaction réelle.
CHARGILY_SECRET_KEY=
CHARGILY_MODE=test

# Coordonnées affichées sur le site
NEXT_PUBLIC_WHATSAPP=213555000000
NEXT_PUBLIC_PHONE=0555 00 00 00
NEXT_PUBLIC_EMAIL=contact@soft4dz.com

# Administration (/admin) — mot de passe de 8 caractères minimum
ADMIN_PASSWORD=
# Optionnel : secret de signature des sessions (chaîne longue et aléatoire)
ADMIN_SECRET=
